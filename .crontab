# ========================================================================
# Trevor Crontab — dormant mode (2026-06-02)
#
# Four jobs. Do not add more without principal approval.
# This file is the single source of truth — also push the same entries
# to the OpenClaw cron registry. If they diverge, this file wins.
# ========================================================================

# ── Inbox sweep (hourly at :05) ─────────────────────────────────────────
# Pulls newsletter/inbox content into tasks/news_raw.md for the next brief.
5 * * * * cd /home/ubuntu/.openclaw/workspace && python3 scripts/agentmail_reader.py --max 20 --save

# ── LEO Ground Stations brief (daily at 13:00 UTC = 06:00 PT) ───────────
0 13 * * * cd /home/ubuntu/.openclaw/workspace && python3 scripts/leo_daily_brief.py

# ── DC Security brief (daily at 13:30 UTC = 06:30 PT) ───────────────────
30 13 * * * cd /home/ubuntu/.openclaw/workspace && python3 scripts/dc_daily_brief.py

# ── RDX / C4 Supply brief (weekly Monday at 15:00 UTC = 08:00 PT) ───────
0 15 * * 1 cd /home/ubuntu/.openclaw/workspace && python3 scripts/rdx_weekly_brief.py

