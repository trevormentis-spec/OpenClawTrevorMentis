# Trevor v2 — Required Environment Variables
# Copy to .env and fill in actual values.
# NEVER commit .env to git.

# ── Provider API Keys (required) ─────────────────────────────────────────

# OpenRouter — frontier models (Claude Opus 4.7, Sonnet 4.5, Vision, nanobanana)
OPENROUTER_API_KEY=

# DeepSeek — mid-tier and high-volume models (V4 Pro, V4 Flash)
DEEPSEEK_API_KEY=

# ElevenLabs — text-to-speech audio generation
ELEVENLABS_API_KEY=

# ── Optional Provider Keys ────────────────────────────────────────────────

# AgentMail — email send/receive for Trevor
AGENTMAIL_API_KEY=

# NewsAPI — news monitoring for source discovery
NEWSAPI_KEY=

# GenViral — social media content generation
GENVIRAL_API_KEY=

# Kalshi — prediction market scanning
KALSHI_API_KEY=

# Buttondown — newsletter publishing
BUTTONDOWN_API_KEY=

# Stripe — subscription management (sandbox or live)
STRIPE_SECRET_KEY=

# Moltbook — community posting
MOLTBOOK_API_KEY=

# Brave Search — web search API
BRAVE_API_KEY=

# GitHub — for landing page deployment
GITHUB_TOKEN=
